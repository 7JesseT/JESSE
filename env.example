# Base Daily Environment Variables
# Copy this file to .env.local and fill in your values

# Network Configuration
NEXT_PUBLIC_DEFAULT_NETWORK=sepolia
CONFIRM_MAINNET=false

# WalletConnect Project ID (get from https://cloud.walletconnect.com/)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id_here

# RPC URLs for Base networks
NEXT_PUBLIC_RPC_URL_SEPOLIA=https://sepolia.base.org
NEXT_PUBLIC_RPC_URL_MAINNET=https://mainnet.base.org

# OnchainKit API Key (optional, for enhanced features)
NEXT_PUBLIC_ONCHAINKIT_API_KEY=your_onchainkit_api_key_here

# Base URL for your application (used for WalletConnect metadata)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Contract addresses
NEXT_PUBLIC_ATTENDANCE_CONTRACT=your_attendance_contract_address
NEXT_PUBLIC_VIP_CONTRACT=0xYourVIPContractAddress
NEXT_PUBLIC_USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e

# Paywall Configuration
NEXT_PUBLIC_PAYWALL_RECIPIENT=0x1234567890123456789012345678901234567890

# Private keys for server-side operations (keep secure!)
MINTER_PRIVATE_KEY=your_minter_private_key_here
ADMIN_PRIVATE_KEY=your_admin_private_key_here

# S3 Configuration (optional)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=your_aws_region
AWS_S3_BUCKET=your_s3_bucket_name

# Admin Configuration
NEXT_PUBLIC_ADMIN_WALLETS=["0x1234567890123456789012345678901234567890","0x2345678901234567890123456789012345678901"]